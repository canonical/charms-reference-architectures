#!/bin/bash

set -euo pipefail

# Runs as the Juju client's user, "ubuntu" on the bastion or the invoking user
# locally. Only the bastion gets its packages upgraded and extra tools.
JUJU=/snap/bin/juju
CREDENTIALS_FILE="$HOME/credentials.yaml"
CREDENTIAL_NAME=azure-option-one
trap 'rm -f "$CREDENTIALS_FILE"' EXIT

if [ "${bastion}" = "true" ]; then
  sudo apt update -y
  sudo apt upgrade -y
  echo "Installing terraform..."
  sudo snap install terraform --classic
  echo "Installing Azure CLI..."
  curl -sL https://aka.ms/InstallAzureCLIDeb | sudo bash
  KUBECONFIG_PATH="$HOME/.kube/config"
else
  # Leaves the user's ~/.kube/config and its current context unchanged
  KUBECONFIG_PATH="$HOME/.kube/juju-aks-config"
fi

# Installed snaps are kept, so a local run does not need sudo
if ! snap list juju >/dev/null 2>&1; then
  echo "Installing juju..."
  sudo snap install juju --channel=3.6
fi
mkdir -p "$HOME/.local/share/juju"

if $JUJU show-controller az >/dev/null 2>&1; then
  echo "Juju controller 'az' already exists, skipping credential setup and bootstrap."
else
  echo "Setting up Azure credentials for Juju..."
  if [ -z "${mi_name}" ]; then
    if [ -z "${app_client_id}" ] || [ -z "${app_password}" ]; then
      echo "Error: app_client_id and app_password must be set when mi_name is not set."
      exit 1
    fi
    echo "Managed identity name is not set, using service principal."
    cat <<EOF >"$CREDENTIALS_FILE"
credentials:
  azure:
    $CREDENTIAL_NAME:
      auth-type: service-principal-secret
      application-id: ${app_client_id}
      application-password: ${app_password}
      subscription-id: ${subscription_id}
EOF
  else
    echo "Using managed identity for Azure credentials..."
    cat <<EOF >"$CREDENTIALS_FILE"
credentials:
  azure:
    $CREDENTIAL_NAME:
      auth-type: managed-identity
      managed-identity-path: ${rg_name}/${mi_name}
      subscription-id: ${subscription_id}
EOF
  fi
  chmod 600 "$CREDENTIALS_FILE"

  echo "Adding Juju credentials..."
  $JUJU add-credential -f "$CREDENTIALS_FILE" --client azure ||
    $JUJU update-credential azure "$CREDENTIAL_NAME" -f "$CREDENTIALS_FILE" --client

  # model-default keeps new models in this resource group and VNet, --config covers the controller model only
  echo "Bootstrapping Juju controller..."
  $JUJU bootstrap "azure/${region}" az \
    --credential "$CREDENTIAL_NAME" \
    --constraints "${controller_constraints}" \
    --model-default "resource-group-name=${rg_name}" \
    --model-default "network=${vnet_name}" \
    --to "subnet=${controller_subnet_name}"
fi

# Checks the controller only, the client may already have a "k8s" cloud
if [ -z "${aks_cluster_name}" ]; then
  echo "AKS cluster name is not set, skipping Kubernetes setup."
elif $JUJU show-cloud k8s --controller az >/dev/null 2>&1; then
  echo "Kubernetes cloud 'k8s' is already registered, skipping Kubernetes setup."
else
  echo "Setting up AKS kubeconfig..."
  mkdir -p "$HOME/.kube"
  cat <<EOF >"$KUBECONFIG_PATH"
${kube_config}
EOF
  chmod 600 "$KUBECONFIG_PATH"

  echo "Setting up Kubernetes on the Juju controller..."
  KUBECONFIG="$KUBECONFIG_PATH" $JUJU add-k8s k8s --controller az
fi

echo "Juju environment setup script completed successfully."
# End of script
