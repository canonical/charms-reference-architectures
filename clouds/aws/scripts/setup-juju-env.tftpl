#!/bin/bash

set -euo pipefail

# Runs as the Juju client's user, "ubuntu" on the bastion or the invoking user
# locally. Only the bastion gets its packages upgraded.
# The confined juju snap can't read ~/.aws, so an inherited profile breaks bootstrap
JUJU="env -u AWS_PROFILE /snap/bin/juju"
CREDENTIALS_FILE="$HOME/credentials.yaml"
CREDENTIAL_NAME=aws-credentials
trap 'rm -f "$CREDENTIALS_FILE"' EXIT

if [ "${bastion}" = "true" ]; then
  sudo apt update -y
  sudo apt upgrade -y
  KUBECONFIG_PATH="$HOME/.kube/config"
else
  # Leaves the user's ~/.kube/config and its current context unchanged
  KUBECONFIG_PATH="$HOME/.kube/juju-eks-config"
fi

# Installed snaps are kept, so a local run does not need sudo
if ! snap list juju >/dev/null 2>&1; then
  echo "Installing juju..."
  sudo snap install juju --channel=3.6
fi
mkdir -p "$HOME/.local/share/juju"

if [ -n "${eks_cluster_name}" ] && ! command -v aws >/dev/null 2>&1; then
  echo "Installing the AWS CLI..."
  sudo snap install aws-cli --classic
  export PATH="$PATH:/snap/bin"
fi

if $JUJU show-controller aws >/dev/null 2>&1; then
  echo "Juju controller 'aws' already exists, skipping credential setup and bootstrap."
else
  echo "Setting up AWS credentials for Juju..."
  cat <<EOF >"$CREDENTIALS_FILE"
credentials:
  aws:
    $CREDENTIAL_NAME:
      auth-type: access-key
      access-key: ${access_key}
      secret-key: ${secret_key}
EOF
  chmod 600 "$CREDENTIALS_FILE"

  echo "Adding Juju credentials..."
  $JUJU add-credential -f "$CREDENTIALS_FILE" --client aws ||
    $JUJU update-credential aws "$CREDENTIAL_NAME" -f "$CREDENTIALS_FILE" --client

  # model-default keeps new models in this VPC, --config covers the controller model only
  echo "Bootstrapping Juju controller..."
  $JUJU bootstrap "aws/${region}" aws \
    --credential "$CREDENTIAL_NAME" \
    --model-default "vpc-id=${vpc_id}" \
    --model-default vpc-id-force=true \
    --to "subnet=${subnet_id}"
fi

# Checks the controller only, the client may already have a "k8s" cloud
if [ -z "${eks_cluster_name}" ]; then
  echo "EKS cluster name is not set, skipping Kubernetes setup."
elif $JUJU show-cloud k8s --controller aws >/dev/null 2>&1; then
  echo "Kubernetes cloud 'k8s' is already registered, skipping Kubernetes setup."
else
  echo "Setting up EKS kubeconfig..."
  mkdir -p "$HOME/.kube"
  aws eks update-kubeconfig \
    --name "${eks_cluster_name}" \
    --region "${region}" \
    --kubeconfig "$KUBECONFIG_PATH"
  chmod 600 "$KUBECONFIG_PATH"

  # The confined juju snap can't run the aws CLI the kubeconfig calls for a token,
  # so this uses the unconfined binary inside the snap
  echo "Setting up Kubernetes on the Juju controller..."
  KUBECONFIG="$KUBECONFIG_PATH" /snap/juju/current/bin/juju add-k8s k8s --controller aws
fi

echo "Juju environment setup script completed successfully."
# End of script
