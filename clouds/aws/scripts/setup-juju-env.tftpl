#!/bin/bash

set -euo pipefail

sudo apt update -y
sudo apt upgrade -y

# Install Juju
echo "Installing juju..."
sudo snap install juju --channel=3.6
echo "Initializing juju..."
sudo -u ubuntu bash -c "mkdir -p ~/.local/share/juju"

# set up aws credentials for juju
echo "Setting up AWS credentials for Juju..."
cat <<EOF >/home/ubuntu/credentials.yaml
credentials:
  aws:
    aws-credentials:
      auth-type: access-key
      access-key: ${access_key}
      secret-key: ${secret_key}
EOF

echo "Setting permissions for credentials.yaml..."
chown ubuntu:ubuntu /home/ubuntu/credentials.yaml
chmod 644 /home/ubuntu/credentials.yaml

if [ -z "${eks_cluster_name}" ]; then
  echo "EKS cluster name is not set, skipping EKS kubeconfig setup."
else
  echo "Setting up EKS kubeconfig..."
  if [ ! -x /snap/bin/aws ]; then
    sudo snap install aws-cli --classic
  fi

  sudo -u ubuntu mkdir -p /home/ubuntu/.kube
  sudo -u ubuntu env \
    HOME=/home/ubuntu \
    AWS_ACCESS_KEY_ID="${access_key}" \
    AWS_SECRET_ACCESS_KEY="${secret_key}" \
    /snap/bin/aws eks update-kubeconfig \
      --name "${eks_cluster_name}" \
      --region "${region}" \
      --kubeconfig /home/ubuntu/.kube/config
  chown ubuntu:ubuntu /home/ubuntu/.kube/config
  chmod 600 /home/ubuntu/.kube/config
fi

if sudo -u ubuntu /snap/bin/juju show-controller aws >/dev/null 2>&1; then
  echo "Juju controller 'aws' already exists, skipping credential setup and bootstrap."
else
  echo "Adding Juju credentials..."
  sudo -u ubuntu /snap/bin/juju add-credential \
    -f /home/ubuntu/credentials.yaml --client aws

  echo "Bootstrapping Juju controller..."
  sudo -u ubuntu /snap/bin/juju bootstrap "aws/${region}" \
    --config "vpc-id=${vpc_id}" \
    --config vpc-id-force=true \
    --to "subnet=${subnet_id}" \
    aws \
    --credential aws-credentials
fi

# set up k8s on the same controller if eks_cluster_name is set
if [ -z "${eks_cluster_name}" ]; then
  echo "EKS cluster name is not set, skipping Kubernetes setup."
else
  echo "Setting up Kubernetes on the Juju controller..."
  sudo -u ubuntu env \
    HOME=/home/ubuntu \
    PATH="/usr/bin:/bin:/snap/bin" \
    KUBECONFIG=/home/ubuntu/.kube/config \
    AWS_ACCESS_KEY_ID="${access_key}" \
    AWS_SECRET_ACCESS_KEY="${secret_key}" \
    /snap/juju/current/bin/juju add-k8s k8s --client --controller aws
fi

echo "Juju environment setup complete."
echo "Cleaning up temporary files..."
rm -f /home/ubuntu/credentials.yaml
echo "Temporary files cleaned up."
echo "Juju environment setup script completed successfully."
# End of script
