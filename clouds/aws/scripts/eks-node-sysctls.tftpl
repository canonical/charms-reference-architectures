Content-Type: text/x-shellscript; charset="us-ascii"

#!/bin/bash
cat > /etc/sysctl.d/99-eks-node-sysctls.conf <<'CONF'
%{ for name, value in sysctls ~}
${name} = ${value}
%{ endfor ~}
CONF
sysctl --system

